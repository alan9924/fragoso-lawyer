    <!-- Scripts locales -->
    <script src="script.js?v=11"></script>
    <script src="precios.js?v=8"></script>
    <script src="analytics.js?v=11"></script>


<script>
  /* ── Acordeón de servicios a la carta ──────────────────────────────────
     El CSS del acordeón ya existía (.acc-item.is-open .acc-content pasa de
     grid-template-rows 0fr a 1fr), pero no había JavaScript que aplicara la
     clase: al hacer clic no ocurría nada y la descripción y el precio de cada
     servicio nunca llegaban a verse. */
  (function () {
    const items = document.querySelectorAll('.acc-item');
    if (!items.length) return;

    const cerrar = (item) => {
      item.classList.remove('is-open');
      const btn = item.querySelector('.acc-btn');
      const panel = item.querySelector('.acc-content');
      if (btn) btn.setAttribute('aria-expanded', 'false');
      /* Se oculta a lectores de pantalla y se saca del orden de tabulación:
         de lo contrario el CTA de un panel cerrado seguiría siendo enfocable. */
      if (panel) panel.setAttribute('aria-hidden', 'true');
    };

    const abrir = (item) => {
      item.classList.add('is-open');
      const btn = item.querySelector('.acc-btn');
      const panel = item.querySelector('.acc-content');
      if (btn) btn.setAttribute('aria-expanded', 'true');
      if (panel) panel.removeAttribute('aria-hidden');
    };

    items.forEach((item, i) => {
      const btn = item.querySelector('.acc-btn');
      const panel = item.querySelector('.acc-content');
      if (!btn || !panel) return;

      // Enlazar botón y panel para lectores de pantalla
      const id = 'acc-panel-' + i;
      panel.id = id;
      btn.setAttribute('aria-controls', id);
      btn.setAttribute('type', 'button');
      cerrar(item);

      btn.addEventListener('click', () => {
        const abierto = item.classList.contains('is-open');
        // Un solo panel abierto a la vez: la lista es larga y así no se pierde el hilo.
        items.forEach(cerrar);
        if (!abierto) abrir(item);
      });
    });
  })();

  /* --nav-h vale 6.5rem pero el navbar real mide más (logo + padding).
     Medimos su altura efectiva para que el fondo del hero arranque justo
     debajo y la barra de menú nunca quede tapada. */
  (function () {
    const nav = document.getElementById('navbar');
    if (!nav) return;
    const sincronizar = () => {
      /* .bottom, no .height: el navbar es fixed y puede tener un desplazamiento
         superior, así que su altura no equivale a dónde termina en pantalla. */
      const h = Math.ceil(nav.getBoundingClientRect().bottom);
      if (h) document.documentElement.style.setProperty('--nav-real-h', h + 'px');
    };
    sincronizar();
    window.addEventListener('resize', sincronizar, { passive: true });
    window.addEventListener('load', sincronizar);
  })();

  /* Las hojas del hero se animan con CSS, pero seguir componiendo transforms
     fuera de pantalla es gasto puro de batería. Al salir el hero del viewport
     se les corta la animación y al volver se reanuda. */
  (function () {
    const hero = document.querySelector('.hero');
    const hojas = document.querySelector('.hero-hojas');
    if (!hero || !hojas) return;

    new IntersectionObserver((entradas) => {
      entradas.forEach((e) => {
        hojas.style.animationPlayState = e.isIntersecting ? '' : 'paused';
        hojas.querySelectorAll('.hoja, .hoja svg').forEach((n) => {
          n.style.animationPlayState = e.isIntersecting ? '' : 'paused';
        });
      });
    }, { threshold: 0 }).observe(hero);
  })();

  /* ── Dispersión de la pila con el scroll ──
     Escribe --p (0 a 1) en el contenedor; el CSS hace el resto. Se activa
     solo cuando la animación de entrada terminó, para que su `forwards` no
     pise los transforms. */
  (function () {
    var caja = document.querySelector('.hero-center-img');
    if (!caja) return;
    var hero = caja.closest('.hero');
    var franjas = caja.querySelectorAll('.pila-franja');
    if (!franjas.length) return;

    /* La última franja en entrar marca el fin de la coreografía de armado. */
    var ultima = franjas[franjas.length - 1];
    var listo = false;
    var armar = function () {
      if (listo) return;
      listo = true;
      caja.classList.add('pila-armada');
      medir();
    };
    ultima.addEventListener('animationend', armar, { once: true });
    /* Red de seguridad: si la animación no corre (reduced-motion, pestaña en
       segundo plano al cargar) el evento nunca llega y la pila se quedaría
       sin dispersarse. */
    setTimeout(armar, 1800);

    var pedido = 0;
    function medir() {
      var alto = hero ? hero.offsetHeight : window.innerHeight;
      /* Se consume en el primer 55% del hero: si se estira más, el usuario ya
         está leyendo otra cosa y la pila sigue ahí a media disolución. */
      var p = Math.min(1, Math.max(0, window.scrollY / (alto * 0.55)));
      caja.style.setProperty('--p', p.toFixed(3));
    }
    function alScroll() {
      if (!listo || pedido) return;
      pedido = requestAnimationFrame(function () { pedido = 0; medir(); });
    }
    window.addEventListener('scroll', alScroll, { passive: true });
    window.addEventListener('resize', alScroll, { passive: true });
  })();
</script>
</body>
</html>
