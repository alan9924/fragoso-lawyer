<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Para Empresas | FERRO FRAGOSO</title>
    <link rel="canonical" href="https://ferrofragoso.com/empresa.html">
    <!-- Open Graph / redes: sin esto, al compartir el link en WhatsApp o LinkedIn
         aparece solo la URL, sin imagen ni descripción. -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://ferrofragoso.com/empresa.html">
    <meta property="og:title" content="Para Empresas | FERRO FRAGOSO">
    <meta property="og:description" content="Tu área legal, sin cargarla a la nómina. Contratos revisados, riesgos vigilados y un socio detrás de cada decisión.">
    <meta property="og:image" content="https://ferrofragoso.com/signature_on_dark.png">
    <meta property="og:site_name" content="Ferro Fragoso, Estudio Jurídico">
    <meta property="og:locale" content="es_MX">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Para Empresas | FERRO FRAGOSO">
    <meta name="twitter:description" content="Tu área legal, sin cargarla a la nómina. Contratos revisados, riesgos vigilados y un socio detrás de cada decisión.">
    <meta name="twitter:image" content="https://ferrofragoso.com/signature_on_dark.png">
    <meta name="description" content="Tu área legal, sin cargarla a la nómina. Contratos revisados, riesgos vigilados y un socio detrás de cada decisión.">
    <link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="favicon-16.png">
    <link rel="icon" type="image/png" sizes="64x64" href="favicon-64.png">
    <link rel="apple-touch-icon" href="apple-touch-icon.png">
    <link rel="stylesheet" href="styles.css?v=14">
    <link rel="stylesheet" href="home-new.css?v=11">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Montserrat:wght@200;300;400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
<style>
  :root{
    --ink:#141d27;--ink-2:#1c2732;--ink-3:#27333f;
    --paper:#f4f1e9;--paper-2:#e9e4d7;
    /* crema del arte del hero: los PNG traen este relleno dentro de las hojas,
       así que el fondo del hero debe ser exactamente el mismo tono. */
    --paper-art:#f3ecda;
    --brass:#c2903f;--brass-deep:#a9762f;--seal:#8a2b34;
    --fog:#8b98a5;--slate:#54626f;
    --line-d:rgba(244,241,233,.12);--line-l:rgba(20,29,39,.12);
    --serif: var(--font-heading, 'Cormorant Garamond', Georgia, serif);
    --sans: var(--font-body, 'Montserrat', system-ui, sans-serif);
    --mono:'IBM Plex Mono',monospace;
  }
  .empresa-body { font-family:var(--sans); background:#ffffff; color:var(--ink); line-height:1.6; -webkit-font-smoothing:antialiased; }
  .empresa-body .wrap { max-width:1080px; margin:0 auto; padding:0 24px; }
  .empresa-body .eyebrow { font-family:var(--mono); font-size:.72rem; letter-spacing:.2em; text-transform:uppercase; color:var(--brass); }
  .empresa-body a { color:inherit; text-decoration:none; }
  .empresa-body .nav-cta-btn { background:#000; color:#fff !important; }
  .empresa-body .btn-c { display:inline-flex; justify-content:center; align-items:center; gap:8px; font-family:var(--sans); font-weight:500; font-size:.92rem; padding:13px 24px; border-radius:999px; cursor:pointer; border:1px solid transparent; transition:.18s; }
  .empresa-body .btn-brass { background:var(--brass); color:#1a130a; } .empresa-body .btn-brass:hover { background:var(--brass-deep); }
  .empresa-body .btn-ghost { background:transparent; border-color:var(--paper); color:var(--paper); font-weight:500; border-width: 1.5px; } .empresa-body .btn-ghost:hover { background:var(--brass); border-color:var(--brass); color:#1a130a; }
  .empresa-body section { padding:74px 0; border-top:none; }
  .empresa-body h2.sec { font-family:var(--serif); font-weight:400; font-size:clamp(1.9rem,4vw,2.7rem); line-height:1.08; letter-spacing:-.01em; margin-bottom: 0; }
  .empresa-body h2.sec em { font-style:italic; color:var(--brass); }

  /* NUEVO HERO EDITORIAL (NOT YOUR SEASON STYLE - DUAL COLUMN) */
  .empresa-body .hero.layout-editorial {
    background: #ffffff;
    padding: calc(var(--nav-real-h, 100px) + 80px) 0 60px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    min-height: 85vh;
  }
  .empresa-body .hero-bg-text {
    display: flex;
    width: 100%;
    max-width: 1600px;
    justify-content: space-around;
    align-items: center;
    position: relative;
    z-index: 1;
    padding: 0 2rem;
  }
  .empresa-body .col-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    font-family: var(--sans);
    color: #111;
    line-height: 0.9;
    letter-spacing: -2px;
  }
  .empresa-body .col-text .line1 { 
    font-size: clamp(2rem, 5vw, 4rem); 
    letter-spacing: 4px; 
    margin-bottom: 0.5rem; 
    font-weight: 200;
  }
  .empresa-body .col-text .line2,
  .empresa-body .col-text .line3 { 
    font-size: clamp(3rem, 9vw, 8rem); 
    font-weight: 300;
  }
  .empresa-body .hero-center-img {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: clamp(200px, 25vw, 350px); 
    height: auto;
    z-index: 10;
    pointer-events: none;
    filter: drop-shadow(0 20px 40px rgba(0,0,0,0.15));
  }
  .empresa-body .hero-center-img img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
  @media (max-width: 900px) {
      .empresa-body .hero-bg-text { flex-direction: column; gap: 4rem; opacity: 0.2; }
      .empresa-body .hero-center-img { width: clamp(150px, 40vw, 250px); }
  }

  /* ── HERO EDITORIAL: tipografía gigante + pila al frente ──
     Funciona por una sola razón: el objeto se MONTA sobre el titular en vez
     de acompañarlo. El texto va detrás y ocupa todo el ancho; la pila se
     centra encima. Si el objeto cabe en un hueco libre, el efecto se pierde. */
  .empresa-body .hero.layout-editorial {
    background: #ffffff;
    padding: calc(var(--nav-real-h, 100px) + 48px) 0 48px;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    border-top: 0;
  }

  .empresa-body .hero-bg-text {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1500px;
    padding: 0 clamp(1rem, 3vw, 2.5rem);
    text-align: center;
    font-family: var(--sans);
    color: #111;
    line-height: .84;
    letter-spacing: -.03em;
    user-select: none;
  }
  .empresa-body .hero-bg-text .line1 {
    font-size: clamp(1.4rem, 3.4vw, 2.6rem);
    font-weight: 200;
    letter-spacing: .12em;
    line-height: 1.1;
    margin-bottom: .35rem;
    /* A la izquierda: la pila también va centrada y lo tapaba por completo. */
    text-align: left;
    padding-left: .12em;
  }
  .empresa-body .hero-bg-text .line2 { font-size: clamp(3.2rem, 13vw, 11rem); font-weight: 300; }
  .empresa-body .hero-bg-text .line3 {
    font-size: clamp(3.2rem, 13vw, 11rem);
    font-weight: 300;
    border-bottom: .07em solid #111;
    display: inline-block;
    padding-bottom: .04em;
  }

  .empresa-body .hero-center-img {
    position: absolute;
    left: 50%;
    bottom: -6%;
    transform: translateX(-50%);
    z-index: 10;
    height: clamp(270px, 46vh, 520px);
    /* Proporción del PNG (573×1094): las 12 franjas son absolutas y sin esto
       el contenedor colapsa a ancho cero. */
    aspect-ratio: 573 / 1094;
    width: auto;
    pointer-events: none;
    filter: drop-shadow(0 18px 40px rgba(17,17,17,.18));
  }

  /* Cada franja es la MISMA imagen recortada a su banda. El recorte va en las
     coordenadas del elemento, así que al trasladarlo se mueve la banda entera
     —recorte y contenido juntos— y se lee como una carpeta acomodándose. */
  .empresa-body .pila-franja {
    position: absolute;
    inset: 0;
    display: block;
    /* +.7% de solape: evita hairlines entre bandas por redondeo subpíxel. */
    clip-path: inset(
      calc((var(--n) - 1 - var(--i)) / var(--n) * 100% - .7%) 0
      calc(var(--i) / var(--n) * 100%) 0);
    opacity: 0;
    transform: translateY(26px);
    animation: pila-acomoda .52s cubic-bezier(.18,.9,.28,1) forwards;
    animation-delay: calc(.25s + var(--i) * .075s);
  }
  .empresa-body .pila-franja img { height: 100%; width: auto; display: block; margin: 0 auto; }

  @keyframes pila-acomoda {
    from { opacity: 0; transform: translateY(26px); }
    to   { opacity: 1; transform: none; }
  }

  @media (max-width: 780px) {
    .empresa-body .hero-center-img { height: clamp(210px, 32vh, 320px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .empresa-body .pila-franja { animation: none; opacity: 1; transform: none; }
  }

  /* ── El desorden que se disuelve ──
     Al hacer scroll la pila se deshace de arriba hacia abajo: las carpetas de
     la cima salen primero, que es como se desarma una pila de verdad. El
     avance lo escribe el JS en --p; cada franja calcula su propio progreso a
     partir de él, así que basta una variable para coreografiar las doce.

     La dispersión vive en `.pila-armada` y no en la regla base porque la
     animación de entrada usa `forwards`: su relleno gana sobre cualquier
     transform que se le ponga encima. Solo cuando termina se apaga y cede. */
  .empresa-body .pila-armada .pila-franja {
    animation: none;
    --lp: clamp(0, (var(--p, 0) - (var(--n) - 1 - var(--i)) * .045) / .5, 1);
    opacity: calc(1 - var(--lp));
    transform:
      translateY(calc(var(--lp) * -90px))
      translateX(calc(var(--lp) * var(--dir) * 52px))
      rotate(calc(var(--lp) * var(--dir) * 9deg));
  }
  @media (prefers-reduced-motion: reduce) {
    .empresa-body .pila-armada .pila-franja { opacity: 1; transform: none; }
  }

  /* problema */
  .empresa-body .problema h2 { max-width:640px; }
  .empresa-body .problema .cols { display:grid; grid-template-columns:1fr 1fr; gap:40px; margin-top:34px; align-items:start; }
  .empresa-body .problema p { color:var(--slate); font-size:1.05rem; margin-bottom: 0; }
  .empresa-body .problema .punch { font-family:var(--serif); font-style:italic; font-size:1.5rem; color:var(--ink); line-height:1.35; }
  .empresa-body .problema .punch b { color:var(--brass); font-style:normal; font-weight:500; }

  
  /* segmentos (Pastel Cards) */
  .empresa-body .segs { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:40px; }
  .empresa-body .seg { border-radius:12px; padding:32px 28px; text-align:center; display:flex; flex-direction:column; align-items:center; }
  .empresa-body .seg-1 { background:#eadecf; } /* beige */
  .empresa-body .seg-2 { background:#cad8c8; } /* mint */
  .empresa-body .seg-3 { background:#d5d4df; } /* lavender */
  .empresa-body .seg-icon { width:140px; height:140px; object-fit:contain; margin-bottom:16px; mix-blend-mode:multiply; }
  .empresa-body .seg h3 { font-family:var(--sans); font-size:1.1rem; font-weight:600; color:#000; margin-bottom:12px; line-height:1.3; }
  .empresa-body .seg p { color:rgba(0,0,0,0.8); font-size:.9rem; line-height:1.5; font-weight:500; }

  /* sistema (Editorial List) */
  .empresa-body .system-split { display:grid; grid-template-columns:1fr 1.5fr; gap:60px; margin-top:40px; align-items:start; }
  .empresa-body .system-head { position:sticky; top:120px; }
  .empresa-body .pillars { display:flex; flex-direction:column; }
  .empresa-body .pillar { display:grid; grid-template-columns:auto 1fr 1fr; gap:32px; padding:32px 0; border-top:1px solid rgba(0,0,0,0.1); }
  .empresa-body .pillar:last-child { border-bottom:1px solid rgba(0,0,0,0.1); }
  .empresa-body .pillar .pnum { font-family:var(--sans); font-size:1.4rem; font-weight:600; color:#000; }
  .empresa-body .pillar h4 { font-family:var(--sans); font-size:1.2rem; font-weight:600; color:#000; margin:0; }
  .empresa-body .pillar p { font-size:.9rem; color:rgba(0,0,0,0.7); margin:0; line-height:1.5; }

  /* planes (Impact Numbers) */
  .empresa-body .grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:34px; align-items:start; }
  .empresa-body .plan { background:#d4d6f5; color:#000; padding:40px 32px; border-radius:0; display:flex; flex-direction:column; height: 100%; }
  .empresa-body .price { font-family:var(--sans); font-size:3.5rem; font-weight:600; line-height:1; margin-bottom:16px; letter-spacing:-0.03em; }
  .empresa-body .price small { font-size:1rem; font-weight:500; opacity:0.8; letter-spacing:0; margin-left:4px; }
  .empresa-body .pname { font-family:var(--sans); font-size:1.2rem; margin-bottom:20px; font-weight:600; opacity:0.9; }
  .empresa-body .plan ul { list-style:none; padding:0; margin:0 0 40px; flex:1; }
  .empresa-body .plan li { font-size:.85rem; color:rgba(0,0,0,0.8); padding:8px 0; display:flex; gap:10px; font-weight:500; }
  .empresa-body .plan li::before { content:"—"; color:rgba(0,0,0,0.4); font-weight:600; }
  .empresa-body .plan .btn-c { width:100%; margin-top:auto; background:#000; color:#fff; border-radius:0; border:none; padding:16px; }
  .empresa-body .plan .btn-c:hover { background:var(--brass); color:#000; }

  /* a la carta (Accordion) */
  .empresa-body .carte-head { max-width:600px; margin-bottom:8px; }
  .empresa-body .carte-head p { color:rgba(0,0,0,0.7); margin-top:12px; font-size:1.05rem; }
  .empresa-body .cgroup { margin-top:48px; border: 1px solid rgba(0,0,0,0.1); border-radius: 12px; overflow: hidden; background: #fff; }
  .empresa-body .cgroup-title { font-family:var(--sans); font-size:.85rem; font-weight:600; letter-spacing:.05em; text-transform:uppercase; color:var(--slate); padding:16px 24px; background: rgba(0,0,0,0.03); border-bottom:1px solid rgba(0,0,0,0.1); margin: 0; }
  .empresa-body .acc-item { border-bottom: 1px solid rgba(0,0,0,0.08); }
  .empresa-body .acc-item:last-child { border-bottom: none; }
  .empresa-body .acc-btn { width: 100%; display: flex; justify-content: space-between; align-items: center; padding: 20px 24px; background: transparent; border: none; cursor: pointer; text-align: left; transition: background 0.2s; }
  .empresa-body .acc-btn:hover { background: rgba(0,0,0,0.02); }
  .empresa-body .acc-title-col { flex: 1; padding-right: 16px; }
  .empresa-body .acc-btn .n { font-family:var(--serif); font-weight:500; font-size:1.35rem; color:#000; letter-spacing:-.01em; display:block; }
  .empresa-body .acc-price-col { display: flex; align-items: center; gap: 20px; }
  .empresa-body .acc-btn .p { font-family:var(--sans); font-size:1.15rem; font-weight:600; color:#000; white-space:nowrap; text-align:right; }
  .empresa-body .acc-btn .p small { font-family:var(--mono); font-size:.7rem; color:rgba(0,0,0,0.5); display:block; letter-spacing:.02em; font-weight:400; margin-top:4px; }
  .empresa-body .acc-icon { display: flex; align-items: center; justify-content: center; width: 24px; height: 24px; transition: transform 0.3s ease; color: var(--slate); }
  .empresa-body .acc-item.is-open .acc-icon { transform: rotate(180deg); }
  
  .empresa-body .acc-content { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
  .empresa-body .acc-item.is-open .acc-content { grid-template-rows: 1fr; }
  .empresa-body .acc-inner { overflow: hidden; }
  .empresa-body .acc-inner .d { font-family:var(--sans); font-size:.9rem; color:rgba(0,0,0,0.7); max-width:640px; line-height:1.6; padding: 0 24px 24px 24px; margin: 0; }

  /* CTA dentro de cada panel del acordeón */
  .empresa-body .acc-cta { margin: 0 24px 24px; background:#000; color:#fff; font-size:.86rem; padding:11px 20px; }
  .empresa-body .acc-cta:hover { background:var(--brass); color:#000; }
  .empresa-body .acc-cta svg { transition: transform .18s; }
  .empresa-body .acc-cta:hover svg { transform: translateX(3px); }
  .empresa-body .acc-inner .d { padding-bottom: 14px; }

  /* Cierre de la sección a la carta */
  .empresa-body .carte-cierre { margin-top:40px; padding:32px 28px; border:1px solid var(--line-l); border-radius:14px; background:rgba(0,0,0,0.015); display:flex; align-items:center; justify-content:space-between; gap:24px; flex-wrap:wrap; }
  .empresa-body .carte-cierre-txt { font-family:var(--sans); font-size:.98rem; color:rgba(0,0,0,0.72); max-width:520px; margin:0; line-height:1.55; }
  .empresa-body .carte-cierre-btn { flex-shrink:0; }
  @media (max-width: 720px) {
    .empresa-body .carte-cierre { flex-direction:column; align-items:stretch; text-align:left; padding:24px 20px; }
    .empresa-body .carte-cierre-btn { width:100%; min-height:48px; }
    .empresa-body .acc-cta { width: calc(100% - 48px); min-height:48px; }
  }

  /* confianza */
  .empresa-body .trust { display:grid; grid-template-columns:1.2fr .8fr; gap:44px; align-items:center; }
  .empresa-body .trust h2 { max-width:440px; }
  .empresa-body .trust p { color:var(--slate); margin-top:16px; }
  .empresa-body .trust .ver { margin-top:18px; font-family:var(--mono); font-size:.8rem; color:var(--fog); }
  .empresa-body .trust .ver a { color:var(--brass); border-bottom:1px solid rgba(194,144,63,.4); }
  .empresa-body .trust-card { background:#fff; border:1px solid var(--line-l); border-radius:16px; padding:28px; display:flex; gap:18px; align-items:flex-start; box-shadow: 0 4px 20px rgba(0,0,0,0.03); }
  .empresa-body .trust-card .ph { width:70px; height:70px; flex:none; border-radius:12px; background:var(--paper); color:var(--brass); display:grid; place-items:center; font-family:var(--serif); font-size:1.4rem; border:1px solid var(--line-l); }
  .empresa-body .trust-card .role { font-family:var(--mono); font-size:.64rem; letter-spacing:.12em; text-transform:uppercase; color:var(--brass); }
  .empresa-body .trust-card h4 { font-family:var(--serif); font-weight:500; font-size:1.2rem; margin:5px 0 6px; color: var(--ink); }
  .empresa-body .trust-card .meta { font-size:.82rem; color:var(--slate); line-height:1.6; }

  /* cierre */
  .empresa-body .cierre { text-align:center; border-top:none; }
  .empresa-body .cierre .wrap { max-width:640px; }
  .empresa-body .cierre h2 { font-size:clamp(2rem,4.4vw,3rem); }
  .empresa-body .cierre p { color:var(--slate); font-size:1.1rem; margin:16px auto 0; max-width:480px; }
  .empresa-body .cierre .btn-c { margin-top:28px; }
  .empresa-body .cierre .fine { font-family:var(--mono); font-size:.72rem; color:var(--fog); margin-top:16px; letter-spacing:.04em; }

  @media(max-width:820px){
    .empresa-body .problema .cols, .empresa-body .segs, .empresa-body .system-split, .empresa-body .grid, .empresa-body .trust { grid-template-columns:1fr; }
    .empresa-body .pillar { grid-template-columns:1fr; gap:12px; }
    .empresa-body .plan.feat { transform:none; order:-1; }
    .empresa-body section { padding:54px 0; }
    .empresa-body .row { flex-wrap:wrap; }
  }
  
  
    /* Premium System Section - SaaS Editorial */
  .premium-system-section {
    padding: 160px 0;
    background: transparent;
  }
  .premium-system-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 5%;
    display: grid;
    grid-template-columns: 1fr;
    gap: 80px;
  }
  
  .premium-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: monospace;
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--taupe-dark, #544e4b);
  }
  .eyebrow-dot {
    width: 6px;
    height: 6px;
    background: #a9b5f9; /* Light purple/blue dot from reference */
  }
  
  .premium-title {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1.05;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--carbon);
    margin: 24px 0;
  }
  
  .premium-system-header p {
    font-family: var(--font-body);
    color: var(--taupe-dark, #544e4b);
    max-width: 480px;
    font-size: 1.15rem;
    line-height: 1.6;
    font-weight: 300;
  }
  
  .premium-system-list {
    position: relative;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .premium-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-bottom: 80px;
    opacity: 0.25;
    transition: opacity 0.6s ease, transform 0.6s ease;
    transform: translateY(20px);
  }
  .premium-item:last-child {
    padding-bottom: 0;
  }
  .premium-item.active {
    opacity: 1;
    transform: translateY(0);
  }
  
  .premium-system-num {
    font-family: monospace;
    font-size: 0.85rem;
    color: var(--taupe-dark, #544e4b);
    margin-bottom: 8px;
  }
  
  .premium-item-title {
    font-family: var(--font-body);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--carbon);
    margin: 0;
    letter-spacing: -0.01em;
  }
  
  .premium-item-desc {
    font-family: var(--font-body);
    font-size: 1.1rem;
    line-height: 1.6;
    font-weight: 300;
    color: var(--taupe-dark, #544e4b);
    margin: 0;
  }

  @media (min-width: 1024px) {
    .premium-system-container {
      grid-template-columns: 1fr 1fr;
      gap: 120px;
      align-items: flex-start;
    }
    .premium-system-header {
      position: sticky;
      top: 180px;
    }
    .premium-system-list {
      padding-left: 80px;
    }
    /* The static background line */
    .premium-system-list::before {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 1px;
      background: rgba(0,0,0,0.1);
    }
    /* The active progress line */
    .premium-system-list::after {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 1px;
      height: var(--progress, 0%);
      background: var(--carbon);
      transition: height 0.1s linear;
    }
  }

  </style>
</head>
